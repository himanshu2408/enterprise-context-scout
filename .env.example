# Database Configuration (PostgreSQL 17 + pgvector + pg_trgm + RLS)
# Admin URL is used ONLY for schema migrations; runtime app MUST use SCOUT_DB_APP_URL (scout_app_user)
SCOUT_DB_ADMIN_URL=postgresql://postgres:postgres_local_admin_pw@127.0.0.1:54329/context_scout
SCOUT_DB_APP_URL=postgresql://scout_app_user:scout_local_dev_pw@127.0.0.1:54329/context_scout

# Google-Only Model Stack (Strict Policy)
SCOUT_PRIMARY_MODEL_ID=google/gemma-4-26B-A4B-it
SCOUT_CONTEXTUALIZER_MODEL_ID=google/gemma-4-E4B-it
SCOUT_TEACHER_MODEL_ID=google/gemma-4-31B-it
SCOUT_EMBEDDING_MODEL_ID=google/embeddinggemma-2
SCOUT_SHIELD_MODEL_ID=google/shieldgemma-2-2b-it
SCOUT_FRONTIER_MODEL_ID=gemini-3.8-flash

# Hardware & Inference Runtime (Auto-detected by default; override below if needed)
# Leave SCOUT_HARDWARE_DEVICE and SCOUT_HARDWARE_MEMORY_GB unset to auto-detect your CPU/GPU & RAM.
# SCOUT_HARDWARE_DEVICE=Apple Silicon M3 Max
# SCOUT_HARDWARE_MEMORY_GB=32.0
SCOUT_LOCAL_MAX_KV_TOKENS=32768
SCOUT_LOCAL_MLX_ENDPOINT=http://127.0.0.1:8000/v1
# Set CONTEXT_SCOUT_USE_LIVE_MLX=1 to execute in-process mlx_lm Metal GPU generation
# CONTEXT_SCOUT_USE_LIVE_MLX=0
# Set GEMINI_API_KEY for live gemini-3.8-flash / gemini-4-argon worktree patch synthesis
# GEMINI_API_KEY=your_gemini_api_key_here
