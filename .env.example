# Database Configuration (PostgreSQL 17 + pgvector + pg_trgm + RLS)
# Admin URL is used ONLY for schema migrations (`context-scout db upgrade` / `seed-demo`);
# runtime app MUST use SCOUT_DB_APP_URL (scout_app_user, NOBYPASSRLS).
SCOUT_DB_ADMIN_URL=postgresql://postgres:postgres_local_admin_pw@127.0.0.1:54329/context_scout
SCOUT_DB_APP_URL=postgresql://scout_app_user:scout_local_dev_pw@127.0.0.1:54329/context_scout

# Local Development Authentication & Embedding Device
# Production (SCOUT_ENV=production|staging) strictly IGNORES SCOUT_ALLOW_INSECURE_DEV_SECRET
# and fails closed unless a >=32-char SCOUT_AUTH_HMAC_SECRET, Cloud IAP, or OIDC IdP is set.
# Load with: uv run uvicorn context_scout.api.main:app --env-file .env --host 127.0.0.1 --port 8080
SCOUT_ENV=development
SCOUT_ALLOW_INSECURE_DEV_SECRET=true
# SCOUT_AUTH_HMAC_SECRET=replace-with-32-plus-char-cryptographic-secret-in-prod
SCOUT_EMBEDDING_DEVICE=cpu

# Default Gemma 4 Stack (BYO Open-Weights supported via config/model_registry.yaml)
SCOUT_PRIMARY_MODEL_ID=google/gemma-4-26B-A4B-it
SCOUT_CONTEXTUALIZER_MODEL_ID=google/gemma-4-E4B-it
SCOUT_TEACHER_MODEL_ID=google/gemma-4-31B-it
SCOUT_EMBEDDING_MODEL_ID=google/embeddinggemma-2
SCOUT_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
SCOUT_SHIELD_MODEL_ID=google/shieldgemma-2-2b-it
# Frontier handoff rate source: config/model_pricing.yaml (e.g. gemini-3.8-flash, gemini-4-hydrogen, gemini-4-neon, gemini-4-carbon)
SCOUT_FRONTIER_MODEL_ID=gemini-3.8-flash

# Air-Gapped / Zero External Egress Default (must be set to true to permit cloud handoff)
SCOUT_ALLOW_EXTERNAL_CLOUD_EGRESS=false
SCOUT_ALLOW_UK_CH_ADEQUACY_REGIONS=false

# Redis & Stateless Streamable HTTP MCP 2026-07-28 Host/Origin Guards
# SCOUT_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# SCOUT_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,context-scout-api
# SCOUT_MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:5173

# Hardware & Inference Runtime (Auto-detected by default; override below if needed)
# Leave SCOUT_HARDWARE_DEVICE and SCOUT_HARDWARE_MEMORY_GB unset to auto-detect your CPU/GPU & RAM.
# SCOUT_HARDWARE_DEVICE=Apple Silicon M3 Max
# SCOUT_HARDWARE_MEMORY_GB=32.0
SCOUT_LOCAL_MAX_KV_TOKENS=32768
SCOUT_LOCAL_MLX_ENDPOINT=http://127.0.0.1:8000/v1
# Set CONTEXT_SCOUT_USE_LIVE_MLX=1 to execute in-process mlx_lm Metal GPU generation
# CONTEXT_SCOUT_USE_LIVE_MLX=0

# Keyless GCP Vertex AI EU-Residency Auth (Workload Identity / ADC; zero static JSON keys)
# Requires SCOUT_ALLOW_EXTERNAL_CLOUD_EGRESS=true for outbound Vertex AI handoff calls.
# SCOUT_USE_VERTEX_AI=true
# SCOUT_GCP_PROJECT=your-gcp-project-id
# SCOUT_GCP_LOCATION=europe-west3
# Non-Vertex local dev override only (requires SCOUT_USE_VERTEX_AI=false & SCOUT_ALLOW_EXTERNAL_CLOUD_EGRESS=true):
# GEMINI_API_KEY=your_gemini_api_key_here
