# syntax=docker/dockerfile:1.7

ARG PYTHON_BUILDER_IMAGE=python:3.12-slim-bookworm
ARG DISTROLESS_PYTHON_IMAGE=gcr.io/distroless/python3-debian12:nonroot

FROM ${PYTHON_BUILDER_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

RUN pip install --no-cache-dir "uv>=0.13.4,<0.14.0"

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --locked --no-dev --no-editable --extra sidecar \
    && pip uninstall -y uv \
    && find /app /usr/local/lib/python3.12 -type d -name '__pycache__' -exec rm -rf {} + \
    && mkdir -p /var/run/scout/adapters \
    && chown -R 65532:65532 /var/run/scout/adapters


FROM ${DISTROLESS_PYTHON_IMAGE} AS runtime

WORKDIR /app

COPY --from=builder /usr/local/bin/python3.12 /usr/bin/python3
COPY --from=builder /usr/local/bin/python3.12 /usr/local/bin/python3.12
COPY --from=builder /usr/local/lib/libpython3.12* /usr/local/lib/
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder --chown=65532:65532 /var/run/scout/adapters /var/run/scout/adapters
COPY --from=builder --chown=65532:65532 /app/.venv /app/.venv
COPY --from=builder --chown=65532:65532 /app/src /app/src
COPY --chown=65532:65532 config /app/config

USER 65532:65532

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp \
    HOME=/tmp \
    SCOUT_ADAPTER_STAGING_DIR=/var/run/scout/adapters \
    LD_LIBRARY_PATH=/usr/local/lib \
    PYTHONPATH=/app/src:/app/.venv/lib/python3.12/site-packages \
    PATH=/app/.venv/bin:/usr/bin:/bin

ENTRYPOINT ["/usr/bin/python3", "-m", "context_scout.serving.adapter_sync_sidecar"]
