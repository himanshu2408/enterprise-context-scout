# syntax=docker/dockerfile:1.7

ARG NODE_BUILDER_IMAGE=node:22-bookworm-slim
ARG NGINX_RUNTIME_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine

FROM ${NODE_BUILDER_IMAGE} AS builder

WORKDIR /app/web-ui

COPY web-ui/package.json web-ui/package-lock.json ./
RUN npm ci --ignore-scripts

COPY web-ui/ ./
RUN npm run build


FROM ${NGINX_RUNTIME_IMAGE} AS runtime

USER 0
RUN apk upgrade --no-cache

COPY --chown=65532:65532 deploy/docker/nginx-airgap.conf /etc/nginx/nginx.conf
COPY --chown=65532:65532 --chmod=0755 deploy/docker/25-scout-resolver.sh /docker-entrypoint.d/25-scout-resolver.sh
COPY --from=builder --chown=65532:65532 /app/web-ui/dist /app/dist

USER 65532:65532

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
