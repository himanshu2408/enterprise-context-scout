{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainKnowledgeBrief",
  "type": "object",
  "required": [
    "brief_title",
    "domain_id",
    "executive_summary",
    "core_findings_and_rules",
    "domain_constraints_and_caveats",
    "known_risks_and_failure_modes",
    "verified_citations"
  ],
  "properties": {
    "brief_title": { "type": "string", "minLength": 1 },
    "domain_id": { "type": "string", "const": "data_engineering_scout" },
    "executive_summary": { "type": "string", "minLength": 1 },
    "formal_expression_or_rule": { "type": ["string", "null"] },
    "core_findings_and_rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "domain_constraints_and_caveats": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "known_risks_and_failure_modes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "structured_metadata": { "type": "object" },
    "verified_citations": { "type": "array", "minItems": 1 }
  }
}
